# GroDel backend — copy to .env and fill in. Never commit the real .env.

# --- Server ---
PORT=8000
NODE_ENV=development

# --- Database ---
MONGODB_URL=

# --- Auth ---
JWT_SECRET=

# --- AI (all AI features route through utils/groq.js) ---
GROQ_API_KEY=
# Optional model overrides; sensible defaults are baked into utils/groq.js
GROQ_MODEL=
GROQ_VISION_MODEL=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Images (Cloudinary) ---
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Nodemailer over Gmail; PASS is a Gmail app password) ---
EMAIL=
PASS=

# --- Translation ---
GOOGLE_TRANSLATE_API_KEY=


# --- URLs ---
# Exact origin of the deployed frontend, no trailing slash.
# Used for CORS while Socket.IO allows the same list.
FRONTEND_URL=https://your-app.vercel.app
CLIENT_URL=

# --- Admin ---
# Hard ceiling on accounts with role=admin. The founding admin can lower it
# further from the dashboard (1-5, persisted in the Settings collection).
MAX_ADMINS=5

# --- Optional tuning ---
# Bulk orders below this total are flagged as under the minimum (default 500).
BULK_ORDER_MINIMUM=500
# Rate limits (defaults: 1000 per 15 min, 10 auth attempts per hour).
# The app fires several API reads per navigation, so a low ceiling throttles
# ordinary browsing — raise it for load testing, not lower it for production.
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10
